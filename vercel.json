{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "dist/server.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["firebase-applet-config.json"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "dist/server.cjs" }
  ]
}
